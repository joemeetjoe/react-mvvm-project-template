{
  "name": "react-mvvm-project-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "host": "vite --host",
    "typecheck": "tsc -b --force",
    "lint": "eslint src/ --ext .ts,.tsx,.js,.jsx",
    "check-circular": "madge --circular --extensions ts,tsx src/",
    "validate": "npm run typecheck && npm run lint && npm run check-circular && npm run test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
